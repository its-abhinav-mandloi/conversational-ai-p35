# Conversational AI Assignment 1 - Phase I (P35: Agricultural Knowledge Navigator)
# Copy this file to .env for local customization. Never commit .env.

# LLM provider mode: local-only | openai | ollama
AGRI_LLM_MODE=local-only

# Optional OpenAI settings (used only when AGRI_LLM_MODE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Ollama settings (used only when AGRI_LLM_MODE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding and retrieval configuration
AGRI_EMBEDDING_BACKEND=sentence-transformers
AGRI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AGRI_CHROMA_DIR=data/processed/chroma_db
AGRI_SQLITE_PATH=data/processed/agri_navigator.db
AGRI_RAW_DOCS_DIR=data/raw
AGRI_TOP_K=4
AGRI_MIN_SIMILARITY=0.32
AGRI_MAX_HISTORY_TURNS=10
AGRI_LOG_LEVEL=INFO
